{
  "name": "optiker-social-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Prototyp: Wochenplanung, Briefing, Freigabe und simulierte Übergabe von Social-Media-Beiträgen",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/cli/main.ts",
    "approve": "tsx src/cli/approve.ts",
    "reset": "tsx src/cli/reset.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/cli/demo.ts",
    "demo:step": "tsx src/cli/demo.ts --step",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
